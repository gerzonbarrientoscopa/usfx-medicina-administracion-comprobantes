# Plantilla local para docker compose.
# Copie este archivo como .env en la raiz y complete los valores secretos alli.

# SQL Server externo; el host usa el formato servidor,puerto.
SQLSERVER_HOST=172.16.1.250,1433
SQLSERVER_TRUSTED_AUTH=false
SQLSERVER_DATABASE=ComprobantesDB

# Credenciales SQL del backend o una cadena completa de conexion.
SQLSERVER_USER=usrweb_comprobantes
SQLSERVER_PASSWORD=
# La imagen validada para SQL Server 2012 instala ODBC Driver 17.
SQLSERVER_DRIVER={ODBC Driver 17 for SQL Server}
SQLSERVER_CONNECTION_STRING=

# Configure JWT_SECRET o SESSION_SECRET; no deje ambos vacios.
JWT_SECRET=
SESSION_SECRET=

# Datos obligatorios para inicializar el Super Admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Puertos externos de esta aplicacion.
BACKEND_PORT=8002
FRONTEND_PORT=3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Configuracion de compilacion del frontend para Docker Compose local.
REACT_APP_BASE_PATH=/
REACT_APP_BACKEND_URL=http://localhost:8002
