# Multi-stage build for React (CRA + craco).
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies with Yarn.
COPY frontend/package.json frontend/yarn.lock* ./
RUN yarn install --frozen-lockfile || yarn install

# Build the app.
COPY frontend/ ./

# Prefijo público de la aplicación
ARG REACT_APP_BASE_PATH=/comprobantes
ENV REACT_APP_BASE_PATH=${REACT_APP_BASE_PATH}

# Build-time env. Override at build with --build-arg REACT_APP_BACKEND_URL=...
ARG REACT_APP_BACKEND_URL=/comprobantes/api
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}

RUN yarn build


# =========================
# Etapa 2: Runtime Node.js
# =========================
FROM node:20-alpine AS runtime

WORKDIR /app

# Servidor HTTP para archivos estáticos
RUN npm install --global serve

COPY --from=build /app/build ./build

EXPOSE 3000

CMD ["serve", "-s", "build", "-l", "3000"]
