# Multi-stage build for React (CRA + craco)
FROM node:20-alpine AS build

WORKDIR /app

# Install deps using yarn
COPY frontend/package.json frontend/yarn.lock* ./
RUN yarn install --frozen-lockfile || yarn install

# Build app
COPY frontend/ ./

# Build-time env. Override at build with --build-arg REACT_APP_BACKEND_URL=...
ARG REACT_APP_BACKEND_URL=http://localhost:8001
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}

RUN yarn build

# --- Runtime ---
FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html

# SPA fallback nginx config
RUN printf 'server {\n  listen 80;\n  server_name _;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
