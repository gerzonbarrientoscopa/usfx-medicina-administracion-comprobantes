JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-caracteres
# Required private administrator credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# URL accesible por el navegador hacia el backend.
# En despliegue local con docker-compose se accede vía http://localhost:8001
REACT_APP_BACKEND_URL=http://localhost:8001

# Servicios de importación opcionales. Configurar en el entorno del backend.
# GET devuelve una lista JSON. No se importan Id del servicio.
CLIENTS_IMPORT_API_URL=
USERS_IMPORT_API_URL=
# Tokens Bearer opcionales; mantener solo en el backend, nunca en REACT_APP_*.
CLIENTS_IMPORT_API_TOKEN=
USERS_IMPORT_API_TOKEN=
