# Backend Dockerfile - FastAPI + MongoDB driver
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
# Definimos los componentes de la URL de paquetes de Microsoft para evitar bloqueos
ENV MS_HOST="packages.microsoft.com"
ENV MS_KEY_PATH="keys/microsoft.asc"
ENV MS_REPO_PATH="config/debian/12/prod.list"

WORKDIR /app

# Deps del sistema para bcrypt/cryptography Y requerimientos obligatorios para pyodbc
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    gnupg \
    unixodbc \
    unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

# Instalar el Driver Oficial de Microsoft ODBC 17 para SQL Server en Linux Debian/Slim
RUN apt-get update && apt-get install -y curl gnupg2 ca-certificates \
    && curl -fsSL https://${MS_HOST}/${MS_KEY_PATH} | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://${MS_HOST}/${MS_REPO_PATH} > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql17 \
    && rm -rf /var/lib/apt/lists/*

# Copiar el nuevo archivo de requerimientos para SQL Server
COPY backend/requirements-sql.txt ./requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY backend/ ./

EXPOSE 8001

CMD ["uvicorn", "serverSQL2012:app", "--host", "0.0.0.0", "--port", "8001"]
